# Lovable Cloud auto-injects these. Copy values from Project → Settings → Secrets.

# --- Stripe (managed by Lovable payments connector) ---
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=

# --- Supabase / Lovable Cloud (auto) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (loaded from .env.development / .env.production) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PAYMENTS_CLIENT_TOKEN=

# --- Internal ---
LOVABLE_API_KEY=
# Optional override for cron → email-sender base URL (defaults to https://getriderite.com)
INTERNAL_ORIGIN=
